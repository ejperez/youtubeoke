{
  "name": "youtubeoke",
  "version": "2.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "conc \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "vite frontend --config frontend/vite.config.js",
    "build": "conc \"npm run build:server\" \"npm run build:frontend\"",
    "build:server": "tsc",
    "build:frontend": "vite build frontend --config frontend/vite.config.js",
    "lint": "eslint --config frontend/eslint.config.js frontend",
    "preview:frontend": "vite preview frontend --config frontend/vite.config.js",
    "cleanup": "tsc --build --clean",
    "start": "node dist/server.js",
    "import-videos": "npm run build:server && node scripts/import-videos.js",
    "test:import-videos": "npm run build:server && node --test tests/import-videos.test.js",
    "test:video-downloader": "npm run build:server && node --test tests/video-downloader.test.js",
    "test:video-file-manager": "npm run build:server && node --test tests/video-file-manager.test.js"
  },
  "allowScripts": {
    "ytdlp-nodejs@3.4.5": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "better-queue": "^3.8.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "youtube-search-api": "^2.0.1",
    "ytdlp-nodejs": "^3.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-queue": "^3.8.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-paginate": "^8.3.0",
    "react-qr-code": "^2.2.0",
    "react-youtube": "^10.1.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
